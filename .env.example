# Copy to .env.local and fill in. Never commit .env.local.
# Names only in this file.

# --- Cloudinary (server only, used by app/api/upload) ---
# Missing values are fine: /api/upload falls back to a mock image.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Supabase (build step 2) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (build step 2, server only) ---
# Missing value is fine: AI routes return mock JSON.
GEMINI_API_KEY=
